// Prisma schema — PostgreSQL (works on Vercel with Neon/Supabase/Vercel Postgres).
// Run: npx prisma db push && npm run db:seed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Lead status pipeline for the admin dashboard
enum LeadStatus {
  NEW
  CONTACTED
  IN_DISCUSSION
  PROPOSAL_SENT
  WON
  LOST
}

/// A website/contact request submitted through the site
model Lead {
  id           String     @id @default(cuid())
  name         String
  email        String
  phone        String?
  businessName String?
  website      String?
  projectType  String?
  budget       String?
  message      String
  /// where the lead came from: "contact" | "request-website" | "calculator"
  source       String     @default("contact")
  /// calculator selections stored as JSON when submitted from the estimator
  details      Json?
  status       LeadStatus @default(NEW)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  notes        LeadNote[]

  @@index([status, createdAt])
  @@index([email])
}

/// Internal note attached to a lead by the admin
model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([leadId])
}

/// Published project / case study
model Project {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  category        String
  description     String
  longDescription String?
  technologies    String[]
  features        String[]
  image           String?
  liveUrl         String
  githubUrl       String?
  caseStudy       Json?
  featured        Boolean  @default(false)
  /// display order, lower first
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active, sortOrder])
}

/// Pricing package — editable from /admin/pricing
model PricingPlan {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  /// one-time price in INR; 0 when billingType = custom
  price        Int      @default(0)
  monthlyPrice Int?
  /// one_time | one_time_plus_monthly | custom
  billingType  String   @default("one_time")
  description  String
  audience     String   @default("")
  features     String[]
  recommended  Boolean  @default(false)
  ctaText      String   @default("Get My Website")
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  updatedAt    DateTime @updatedAt
}

/// Blog post — markdown body, managed from /admin/blog
model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String
  /// markdown
  content         String
  category        String    @default("General")
  tags            String[]
  coverImage      String?
  featured        Boolean   @default(false)
  published       Boolean   @default(false)
  publishedAt     DateTime?
  readingTimeMin  Int       @default(5)
  /// optional SEO overrides
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published, publishedAt])
}

/// FAQ entry — managed from admin, rendered on /faq with FAQPage schema
model Faq {
  id        String  @id @default(cuid())
  question  String
  answer    String
  category  String  @default("General")
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

/// Service offering — managed from admin, rendered on /services
model Service {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortDescription String
  description      String
  features         String[]
  icon             String   @default("Code2")
  featured         Boolean  @default(false)
  sortOrder        Int      @default(0)
  active           Boolean  @default(true)
}

/// Key/value site settings editable from admin (hero copy, contact info, etc.)
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

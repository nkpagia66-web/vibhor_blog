# ---- Database (required for leads/admin/blog persistence) ----
# PostgreSQL connection string. On Vercel use Neon / Supabase / Vercel Postgres.
DATABASE_URL="postgresql://user:password@host:5432/vibhoragarwal?schema=public"

# ---- Site ----
# Canonical site URL (no trailing slash). Used for SEO canonical/OG/sitemap.
NEXT_PUBLIC_SITE_URL="https://vibhoragarwal.blog"

# ---- Admin authentication ----
# Generate a secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-with-64-plus-characters-random-string"
# Admin login credentials
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password"
# Optional: instead of ADMIN_PASSWORD you may set a scrypt hash (see scripts/hash-password note in README)
# ADMIN_PASSWORD_HASH="scrypt$salt$hash"

# ---- Contact (public site reads these) ----
NEXT_PUBLIC_WHATSAPP_NUMBER="917668397233"
NEXT_PUBLIC_CONTACT_EMAIL="hptpled@gmail.com"

# ---- Analytics (optional, off unless set) ----
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ---- Rate limiting ----
# Requests per minute per IP for public form endpoints (default 5 if unset)
# RATE_LIMIT_PER_MINUTE="5"
